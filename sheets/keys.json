{
  "sheet": "keys",
  "about": "Keys New Vegas forwards to Minecraft. Codes are xNVSE key codes (DirectInput scancodes; mouse buttons 256+, wheel 264/265). 'build' rows only act in build mode, and New Vegas ignores those keys while it is on.",
  "columns": {
    "id": "row id",
    "nv_code": "xNVSE key code",
    "key_name": "key as players know it",
    "mode": "always | build",
    "mc_action": "message sent to Minecraft: key:<name> | slot:<n> | scroll:<d> | toggle_build | salvage",
    "verified": "status"
  },
  "rows": [
